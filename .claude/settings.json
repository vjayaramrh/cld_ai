{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/guard-commit-on-main.sh" },
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/gate-pr-merge.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/scripts/hooks/check-module-edit.sh" }
        ]
      }
    ]
  }
}
